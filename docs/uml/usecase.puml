@startuml
title COLORS Lab — Use Case Diagram

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowColor #202020
skinparam ArrowThickness 1.5
skinparam nodesep 50
skinparam ranksep 45
skinparam packageStyle rectangle
skinparam packageTitleAlignment left
skinparam actorBorderColor #202020
skinparam actorFontColor #111111
skinparam usecase {
  BackgroundColor #EEEEEE
  BorderColor #202020
  FontColor #111111
}
skinparam rectangle {
  BorderColor #202020
  FontColor #111111
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #D97706
  FontSize 14
}

actor "User" as User

rectangle "COLORS Lab application" as App {
  usecase "Log in" as Login
  usecase "Add a color" as Add
  usecase "Search own colors" as Search
  usecase "Log out" as Logout
  Logout -[hidden]right-> Search
  Search -[hidden]right-> Add
  Add -[hidden]right-> Login
}

User -- Login
User -- Add
User -- Search
User -- Logout

legend bottom
  Stick figure = user. 
  Oval = action. 
  Rectangle = application boundary.
  Scope: existing accounts; no registration, editing, or deletion.
  Login is a precondition for the color page, not an <<include>> of every action.
  The PHP color endpoints receive userId; they do not verify a server-side session.
endlegend
@enduml
